<div class="table-header">
    <div>
        <h2>@Title</h2>
        <p>@TableName</p>
    </div>
    <div class="pager" aria-label="@($"{Title} day navigation")">
        <button type="button" @onclick="() => OnDayChanged.InvokeAsync(PreviousDate)"
                disabled="@IsPreviousDisabled">Previous day
        </button>
        <span>@CurrentDateLabel (@TotalCount.ToString("N0") rows)</span>
        <button type="button" @onclick="() => OnDayChanged.InvokeAsync(NextDate)"
                disabled="@IsNextDisabled">Next day
        </button>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] [EditorRequired] public string TableName { get; set; } = string.Empty;
    [Parameter] public string? CurrentDate { get; set; }
    [Parameter] public string? PreviousDate { get; set; }
    [Parameter] public string? NextDate { get; set; }
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<string?> OnDayChanged { get; set; }

    private string CurrentDateLabel => string.IsNullOrWhiteSpace(CurrentDate)
        ? "No day selected"
        : CurrentDate;

    private bool IsPreviousDisabled => IsLoading || string.IsNullOrWhiteSpace(PreviousDate);
    private bool IsNextDisabled => IsLoading || string.IsNullOrWhiteSpace(NextDate);
}
