@inherits LayoutComponentBase
@inject NavigationManager Navigation

<nav class="top-nav" aria-label="Primary">
    <a href="@BuildSharedFilterUrl("/stock-prices")">Stock Prices</a>
    <a href="@BuildSharedFilterUrl("/trends")">Trends</a>
</nav>

<main>
    @Body
</main>

@code {
    private string BuildSharedFilterUrl(string path)
    {
        var current = Navigation.ToAbsoluteUri(Navigation.Uri);
        return $"{path}{current.Query}";
    }
}
