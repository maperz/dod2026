@page "/Error"

<PageTitle>Error</PageTitle>

<div class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Application error</p>
            <h1>Something went wrong</h1>
        </div>
        <a class="secondary-link" href="/stock-prices">Stock Prices</a>
    </header>

    <div class="error" role="alert">
        The application could not complete the request. Try again, or return to Stock Prices.
    </div>
</div>
