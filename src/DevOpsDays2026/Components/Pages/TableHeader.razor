<div class="table-header">
    <div>
        <h2>@Title</h2>
        <p>@TableName</p>
    </div>
    <div class="pager" aria-label="@($"{Title} day navigation")">
        <button type="button" @onclick="() => OnDayChanged.InvokeAsync(PreviousDate)"
                disabled="@IsPreviousDisabled">Previous day
        </button>
        <span>@CurrentDateLabel (@TotalCount.ToString("N0") rows)</span>
        <button type="button" @onclick="() => OnDayChanged.InvokeAsync(NextDate)"
                disabled="@IsNextDisabled">Next day
        </button>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] [EditorRequired] public string TableName { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset? CurrentDate { get; set; }
    [Parameter] public DateTimeOffset? PreviousDate { get; set; }
    [Parameter] public DateTimeOffset? NextDate { get; set; }
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> OnDayChanged { get; set; }

    private string CurrentDateLabel => CurrentDate is null
        ? "No day selected"
        : StockFormat.Date(CurrentDate.Value);

    private bool IsPreviousDisabled => IsLoading || PreviousDate is null;
    private bool IsNextDisabled => IsLoading || NextDate is null;
}
